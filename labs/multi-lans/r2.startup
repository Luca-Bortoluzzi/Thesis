#!/bin/bash
# Auto-generated startup file for node: r2
set -e

# eth0 -> lan_b
ip link set eth0 up
ip addr add 10.10.2.1/24 dev eth0

# eth1 -> r1_r2
ip link set eth1 up
ip addr add 10.0.12.2/30 dev eth1

# eth2 -> r2_r3
ip link set eth2 up
ip addr add 10.0.23.1/30 dev eth2

# eth3 -> r2_r4
ip link set eth3 up
ip addr add 10.0.24.1/30 dev eth3

# Enable IPv4 forwarding
sysctl -w net.ipv4.ip_forward=1

# Start FRR
chown -R frr:frr /etc/frr || true
chmod 640 /etc/frr/daemons || true
chmod 640 /etc/frr/frr.conf || true
service frr start || /usr/lib/frr/frrinit.sh start || true
