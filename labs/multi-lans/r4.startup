#!/bin/bash
# Auto-generated startup file for node: r4
set -e

# eth0 -> lan_d
ip link set eth0 up
ip addr add 10.10.4.1/24 dev eth0

# eth1 -> r2_r4
ip link set eth1 up
ip addr add 10.0.24.2/30 dev eth1

# eth2 -> r3_r4
ip link set eth2 up
ip addr add 10.0.34.2/30 dev eth2

# Enable IPv4 forwarding
sysctl -w net.ipv4.ip_forward=1

# Start FRR
chown -R frr:frr /etc/frr || true
chmod 640 /etc/frr/daemons || true
chmod 640 /etc/frr/frr.conf || true
service frr start || /usr/lib/frr/frrinit.sh start || true
